# Entity service
ENTITY_BASE_URL=
ENTITY_TOKEN_URL=
ENTITY_CLIENT_ID=
ENTITY_CLIENT_SECRET=
ENTITY_SCOPES=

# Trusted M2M actor identity, asserted on POST /cases/{id}/comments and
# POST /cases/{id}/tags. Must be in entity-service's trusted-actor allowlist.
UMT_INTEGRATION_ACTOR_EMAIL=

# Per-third-party-client actor email, used only to attribute a markFixIssued
# PATCH /cases/{id} call to the real caller instead of this service's own
# shared client id. Format: clientId1:email1,clientId2:email2
MARK_FIX_ISSUED_ACTOR_EMAILS=

# Server
PORT=8080
