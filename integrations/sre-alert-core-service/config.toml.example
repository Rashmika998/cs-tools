[poll]
# Backstop cadence: ensures a lost or malformed ping never loses an alert. With multiple
# replicas a ping may reach a standby, so this also bounds worst-case pickup latency on the leader.
interval = "10s"
# Fingerprint-sharded workers handling alerts in parallel each cycle (distinct incidents run
# concurrently; same-fingerprint alerts stay serialized to one worker).
concurrency = 128
# Parallel alert-row reads at the start of each cycle.
read_concurrency = 64
# Max alert ids processed per cycle; bounds memory under large bursts.
max_window = 2000
# Bounds how long a single missing alert id blocks every id after it before this service skips it
# (loudly logged) instead of stalling the whole pipeline forever.
gap_timeout = "10m"

[lease]
# Elects a single active poller across replicas: only the lease holder processes alerts, so
# multiple Choreo containers never send duplicate incident notifications.
ttl = "15s"
# How often the leader renews its lease; must be well under ttl.
renew_interval = "5s"

[cassandra]
# Bounds Cassandra's startup connection retry so a transient blip doesn't crash-loop the pod.
connect_max_attempts = 5
connect_base_delay = "2s"
# Per-connection and per-query timeouts against Cosmos DB for Apache Cassandra.
connect_timeout = "10s"
query_timeout = "10s"

[notify]
# Bounds retries per downstream target (CSM, Chat webhooks); base delay doubles each attempt.
max_attempts = 3
retry_base_delay = "200ms"
http_timeout = "10s"
# How often the poller retries incidents whose CSM/Chat notification still hasn't succeeded (e.g.
# an extended Chat outage that outlasted max_attempts). Independent of poll.interval: this never
# blocks alert ingestion, it only recovers stuck notifications in the background.
retry_sweep_interval = "30s"
# Bounds how many failed CreateIncident attempts an incident absorbs before it's marked
# permanently failed and dropped from the retry sweep.
max_csm_attempts = 20
# How long a resolved alert-Service-label -> CMDB-service-id mapping is reused before a fresh
# live /services/search call.
service_cache_ttl = "15m"

[server]
# Bounds how long SIGTERM/SIGINT waits for in-flight work before forcing exit.
shutdown_grace = "15s"
